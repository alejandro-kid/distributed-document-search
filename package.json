{
  "name": "document-search-service",
  "version": "1.0.0",
  "description": "Distributed document search service capable of searching through millions of documents with sub-second response times",
  "main": "src/start.ts",
  "scripts": {
    "start": "NODE_ENV=production node dist/src/start.js",
    "dev": "NODE_ENV=development nodemon --watch src --watch config --watch .env --ext ts,json,env,css,html,yml,yaml --exec \"tsx --tsconfig tsconfig.json src/start.ts\"",
    "build": "pnpm build:clean && pnpm build:tsc && pnpm build:di",
    "build:tsc": "swc src -d dist",
    "build:di": "cpy \"src/**/*.{json,yaml,yml,html,png}\" dist/src --parents",
    "build:clean": "rm -r dist; exit 0",
    "check:type": "tsc --noEmit",
    "check": "pnpm check:type && pnpm lint:fix",
    "lint:fix": "eslint . --fix",
    "db:create-schema": "tsx src/database/create_schema.ts",
    "test": "NODE_ENV=test tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js --publish",
    "test:unit": "jest",
    "test:all": "pnpm check && pnpm test:unit && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "axios": "^1.12.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "errorhandler": "^1.5.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "glob": "^11.0.3",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "jose": "^6.1.0",
    "js-yaml": "^4.1.0",
    "node-dependency-injection": "~3.2.2",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@eslint/js": "^9.35.0",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.6.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/compression": "^1.8.1",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
